# Enable directory access
Options +Indexes
Options +FollowSymLinks
DirectoryIndex index.php

# Enable PHP processing
AddType application/x-httpd-php .php

# Set UTF-8 encoding
AddDefaultCharset UTF-8

# Handle errors - redirect all errors to index.php
ErrorDocument 404 /DBMS_project/index.php
ErrorDocument 403 /DBMS_project/index.php
ErrorDocument 500 /DBMS_project/index.php

# Enable URL rewriting
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /DBMS_project/
    
    # If the request is for a real file or directory, don't rewrite
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Forward all other requests to index.php
    RewriteRule ^ index.php [L]
</IfModule>